# PostgreSQL
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/own_workflow

# Docker Compose host port
APP_PORT=8000

# OpenAI-compatible LLM
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Content collection
TIKHUB_API_KEY=your-tikhub-api-key

# Image generation
OPENAI_IMAGE_BASE_URL=https://www.right.codes/draw/v1
OPENAI_IMAGE_MODEL=gpt-image-2

# Provider console links
TIKHUB_RECHARGE_URL=https://user.tikhub.io/dashboard/add-credit
TIKHUB_CONSOLE_URL=https://user.tikhub.io/dashboard/overview
TIKHUB_LOG_URL=https://user.tikhub.io/dashboard/log
LLM_RECHARGE_URL=https://right.codes/subscribe
LLM_CONSOLE_URL=https://right.codes/api-keys
LLM_LOG_URL=https://right.codes/use-logs

# Optional billing rates for wallet accounting (CNY)
# Leave them at 0 to only record usage entries without affecting balance.
BILLING_LLM_INPUT_COST_PER_1K_TOKENS=0
BILLING_LLM_OUTPUT_COST_PER_1K_TOKENS=0
BILLING_TIKHUB_REQUEST_COST=0
BILLING_IMAGE_GENERATION_COST_PER_IMAGE=0
BILLING_IMAGE_EDIT_COST_PER_IMAGE=0

# Scheduler
SCHEDULE_POLL_INTERVAL_SECONDS=15
SCHEDULE_STALE_LOCK_SECONDS=600

# S3-compatible object storage for generated images
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# Optional S3 settings
S3_SESSION_TOKEN=
S3_KEY_PREFIX=generated-assets
S3_PUBLIC_BASE_URL=https://cdn.example.com/generated-assets
